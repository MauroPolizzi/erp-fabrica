// Prisma schema — ERP Fábrica (PerliNor)
// Convenciones (CONTEXT §7):
//   - IDs uuid (@default(uuid()))
//   - Tablas snake_case via @@map, campos snake_case via @map (camelCase en código)
//   - Montos: Decimal(12,2) | Cantidades: Decimal(12,3)
//   - Timestamps: created_at (@default(now())) / updated_at (@updatedAt)
//   - Borrado lógico: isActive (sin borrado físico)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────── Core ──────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  roleId       String   @map("role_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role                Role                 @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]
  createdSales        Sale[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Token de recuperación de contraseña. Se persiste el SHA-256 del token (nunca el
/// token en claro, que solo viaja en el mail) para que una filtración de la base no
/// habilite tomar cuentas. `usedAt` garantiza un único uso.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // formato modulo.accion (ej: inventory.read)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

// M2M explícita Role ↔ Permission
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ──────────────────────────── Empleados ───────────────────────────

model Employee {
  id        String    @id @default(uuid())
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  document  String    @unique
  position  String?
  phone     String?
  email     String?
  hireDate  DateTime? @map("hire_date")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("employees")
}

// ─────────────────────────── Inventario ───────────────────────────

enum CategoryType {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

enum MovementType {
  IN
  OUT
  ADJUST
}

model Category {
  id        String       @id @default(uuid())
  name      String
  type      CategoryType
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  rawMaterials     RawMaterial[]
  finishedProducts FinishedProduct[]

  @@unique([name, type])
  @@map("categories")
}

model RawMaterial {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  categoryId   String   @map("category_id")
  unit         String // unidad de medida (kg, lt, u, ...)
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  averageCost  Decimal  @default(0) @map("average_cost") @db.Decimal(12, 2) // costo promedio ponderado
  minStock     Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category    Category                @relation(fields: [categoryId], references: [id])
  movements   RawMaterialMovement[]
  consumption ProductionConsumption[]

  @@map("raw_materials")
}

model RawMaterialMovement {
  id            String       @id @default(uuid())
  rawMaterialId String       @map("raw_material_id")
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 3)
  unitCost      Decimal      @default(0) @map("unit_cost") @db.Decimal(12, 2)
  reference     String? // origen del movimiento (compra, producción, ajuste)
  createdAt     DateTime     @default(now()) @map("created_at")

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([rawMaterialId])
  @@map("raw_material_movements")
}

model FinishedProduct {
  id           String   @id @default(uuid())
  sku          String   @unique // codigo de referencia
  name         String
  categoryId   String   @map("category_id")
  unit         String
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  salePrice    Decimal  @default(0) @map("sale_price") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category    Category                  @relation(fields: [categoryId], references: [id])
  movements   FinishedProductMovement[]
  saleDetails SaleDetail[]
  production  ProductionRecord[]

  @@map("finished_products")
}

model FinishedProductMovement {
  id                String       @id @default(uuid())
  finishedProductId String       @map("finished_product_id")
  type              MovementType
  quantity          Decimal      @db.Decimal(12, 3)
  reference         String?
  createdAt         DateTime     @default(now()) @map("created_at")

  finishedProduct FinishedProduct @relation(fields: [finishedProductId], references: [id])

  @@index([finishedProductId])
  @@map("finished_product_movements")
}

// ─────────────────────────── Producción ───────────────────────────

model ProductionRecord {
  id                String   @id @default(uuid())
  finishedProductId String   @map("finished_product_id")
  quantity          Decimal  @db.Decimal(12, 3)
  producedAt        DateTime @default(now()) @map("produced_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  finishedProduct FinishedProduct         @relation(fields: [finishedProductId], references: [id])
  consumptions    ProductionConsumption[]

  @@index([finishedProductId])
  @@map("production_records")
}

model ProductionConsumption {
  id                 String  @id @default(uuid())
  productionRecordId String  @map("production_record_id")
  rawMaterialId      String  @map("raw_material_id")
  quantity           Decimal @db.Decimal(12, 3)
  unitCost           Decimal @default(0) @map("unit_cost") @db.Decimal(12, 2)

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  rawMaterial      RawMaterial      @relation(fields: [rawMaterialId], references: [id])

  @@index([productionRecordId])
  @@index([rawMaterialId])
  @@map("production_consumptions")
}

// ──────────────────────────── Comercial ───────────────────────────

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CHECK
  ACCOUNT
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  taxId     String?  @map("tax_id") // documento del cliente
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales Sale[]

  @@map("customers")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  taxId     String?  @map("tax_id")
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments SupplierPayment[]

  @@map("suppliers")
}

model Sale {
  id            String        @id @default(uuid())
  customerId    String        @map("customer_id")
  createdById   String?       @map("created_by") // usuario que registró la venta
  status        SaleStatus    @default(DRAFT)
  paymentMethod PaymentMethod @map("payment_method")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  soldAt        DateTime      @default(now()) @map("sold_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer      Customer       @relation(fields: [customerId], references: [id])
  createdBy     User?          @relation(fields: [createdById], references: [id])
  details       SaleDetail[]
  invoice       Invoice?
  cashMovements CashMovement[]

  @@index([customerId])
  @@index([createdById])
  @@map("sales")
}

model SaleDetail {
  id                String  @id @default(uuid())
  saleId            String  @map("sale_id")
  finishedProductId String  @map("finished_product_id")
  quantity          Decimal @db.Decimal(12, 3)
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)

  sale            Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  finishedProduct FinishedProduct @relation(fields: [finishedProductId], references: [id])

  @@index([saleId])
  @@map("sale_details")
}

// ──────────────────────────── Finanzas ────────────────────────────

enum CashType {
  SALES
  PAYMENTS
}

enum InvoiceType {
  A
  B
  C
  RECEIPT
}

enum InvoiceStatus {
  PENDING
  ISSUED
  CANCELLED
}

model CashRegister {
  id        String   @id @default(uuid())
  name      String
  type      CashType
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements CashMovement[]

  @@map("cash_registers")
}

model CashMovement {
  id             String   @id @default(uuid())
  cashRegisterId String   @map("cash_register_id")
  amount         Decimal  @db.Decimal(12, 2) // positivo ingreso / negativo egreso
  description    String?
  saleId         String?  @map("sale_id")
  createdAt      DateTime @default(now()) @map("created_at")

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id])

  @@index([cashRegisterId])
  @@map("cash_movements")
}

model SupplierPayment {
  id          String        @id @default(uuid())
  supplierId  String        @map("supplier_id")
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  description String?
  paidAt      DateTime      @default(now()) @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_payments")
}

model Invoice {
  id        String        @id @default(uuid())
  saleId    String        @unique @map("sale_id")
  type      InvoiceType
  status    InvoiceStatus @default(PENDING)
  number    String? // número de comprobante
  cae       String? // CAE para factura electrónica (AFIP)
  caeExpiry DateTime?     @map("cae_expiry")
  total     Decimal       @db.Decimal(12, 2)
  issuedAt  DateTime?     @map("issued_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("invoices")
}

// ──────────────────────────── Auditoría ───────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String // CREATE | UPDATE | DELETE
  entity    String
  entityId  String   @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
