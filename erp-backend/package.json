{
  "name": "erp-backend",
  "version": "1.0.0",
  "description": "API REST del ERP PerliNor (Node.js + Express + TypeScript + Prisma)",
  "license": "ISC",
  "engines": {
    "node": ">=20.11.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "bullmq": "5.25.5",
    "compression": "1.7.5",
    "cors": "2.8.5",
    "dayjs": "1.11.13",
    "decimal.js": "10.4.3",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "pdfkit": "0.15.1",
    "uuid": "10.0.0",
    "winston": "3.15.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.6",
    "@types/pdfkit": "0.13.5",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "eslint": "9.14.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
