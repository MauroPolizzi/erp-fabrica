# Entorno de TESTS. Copiar a .env.test (no se versiona) y completar.
# La suite de Vitest carga este archivo vía tests/setup.ts ANTES de la config del
# backend, para correr contra una base de datos DEDICADA (no la de desarrollo).
NODE_ENV=test
PORT=3001
FRONTEND_URL=http://localhost:4200

# PostgreSQL — base de datos SEPARADA de la de dev (erp_db). Crear `erp_test`.
# (mismo Postgres del docker-compose.yml, distinta DB)
DATABASE_URL="postgresql://erp_user:erp_dev_password@localhost:5432/erp_test?schema=public"

# JWT — secretos de test (no son sensibles). En CI usar variables del job.
JWT_ACCESS_SECRET=test_access_secret
JWT_REFRESH_SECRET=test_refresh_secret

# Paginación
DEFAULT_PAGINATION_LIMIT=20
MAX_PAGINATION_LIMIT=100
