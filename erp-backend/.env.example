# Copiar a .env y completar. El .env real NO se versiona.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://erp_user:erp_dev_password@localhost:5432/erp_db?schema=public"

# Redis (BullMQ / cache)
REDIS_URL=redis://localhost:6379

# JWT — generar secretos fuertes en cada entorno
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret

# Paginación
DEFAULT_PAGINATION_LIMIT=20
MAX_PAGINATION_LIMIT=100
