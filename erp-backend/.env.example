# Copiar a .env y completar. El .env real NO se versiona.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://erp_user:erp_dev_password@localhost:5432/erp_db?schema=public"

# JWT — generar secretos fuertes en cada entorno
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret

# Paginación
DEFAULT_PAGINATION_LIMIT=20
MAX_PAGINATION_LIMIT=100

# Recuperación de contraseña — vigencia del link en minutos
PASSWORD_RESET_TTL_MINUTES=30

# SMTP — opcional. Sin SMTP_HOST no se envían mails: el link de recuperación se
# escribe en el log (modo desarrollo). En producción, configurarlo siempre.
# Los valores de abajo apuntan a Mailpit (docker-compose.yml): bandeja de prueba
# en http://localhost:8025, sin usuario ni contraseña.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ERP PerliNor <no-reply@perlinor.local>"
